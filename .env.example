# LLM=mock needs no key. LLM=openai uses function calling.
LLM=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# SPEECH=text keeps audio as UTF-8 text; SPEECH=openai uses Whisper + OpenAI TTS;
# SPEECH=elevenlabs uses ElevenLabs Scribe (speech to text) + ElevenLabs TTS.
SPEECH=text
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8MeAtD
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
